{
  "name": "@svelteframe/cli",
  "version": "0.0.1",
  "description": "Command-line interface for rendering Svelteframe video compositions",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "svelteframe": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precheck": "pnpm --filter @svelteframe/renderer build",
    "check": "tsc --noEmit",
    "pretest": "pnpm --filter @svelteframe/renderer build && pnpm run build",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@svelteframe/core": "workspace:^",
    "@svelteframe/renderer": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "svelte",
    "svelteframe",
    "video",
    "cli"
  ]
}
