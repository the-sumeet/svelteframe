{
  "name": "@svelteframe/renderer",
  "version": "0.0.1",
  "description": "Headless browser and ffmpeg rendering engine for Svelteframe",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "svelte",
    "svelteframe",
    "video",
    "renderer",
    "ffmpeg",
    "playwright"
  ]
}
