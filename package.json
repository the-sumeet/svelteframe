{
  "name": "svelteframe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:core": "pnpm --filter @svelteframe/core watch",
    "dev:play": "pnpm --filter playground dev",
    "render": "pnpm --filter @svelteframe/renderer exec tsx src/render.ts",
    "test": "pnpm -r --if-present test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
