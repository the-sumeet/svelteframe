{
  "name": "svelteframe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "dev:core": "pnpm --filter @svelteframe/core watch",
    "dev:play": "pnpm --filter playground dev",
    "svelteframe": "svelteframe --root apps/playground",
    "render": "pnpm --filter @svelteframe/renderer exec tsx src/cli.ts",
    "test": "pnpm -r --if-present test",
    "docs:dev": "pnpm --filter @svelteframe/docs dev",
    "docs:build": "pnpm --filter @svelteframe/docs build"
  },
  "devDependencies": {
    "@svelteframe/cli": "workspace:*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
